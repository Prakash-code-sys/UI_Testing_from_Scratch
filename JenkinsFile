pipeline {
    agent any 

      options{
        buildDiscarder(logRotator(
            numToKeepStr : '10',
            artifactNumToKeepStr: '10'
        ))
      }
        stages{
            stage('1.Check out'){
                steps{
                     git branch: 'main',
                     url: 'https://github.com/Prakash-code-sys/UI_Testing_from_Scratch'
                }
                
            }
            stage('2.Install Playwright'){
                steps{
                    bat 'npm ci'
                    bat 'npx playwright install'
                }
            }
            stage('3.Run tests'){
                steps{
                    bat 'npx playwright test'
                }
            }

        }

        post {
            always {
                archiveArtifacts( 
                    artifacts: 'playwright-report/**',
                    allowEmptyArchive: true
                )

                junit (
                    testResults: 'test-results/*.xml',
                    allowEmptyResults: true
                )
                emailext(
                    subject: "Jenkins Build:",
                    body: "Build result: Build URL: ",
                    to: 'prakashraj.manimaran@gmail.com'
                )
            }
        }
    
}